# SkyWarden Environment Configuration Example
# Copy to .env for local deployment

# Platform
ENVIRONMENT=development
PORT=8000
VITE_API_URL=http://localhost:8000

# Open-Meteo Weather (Free Tier, No API Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# SQLite Persistence
SQLITE_DB_PATH=./skywarden.db

# Optional AI / Tavily Integration (Developer A)
TAVILY_API_KEY=
NVIDIA_NIM_API_KEY=
